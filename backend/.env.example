# --- Database ---
# Production/dev Postgres connection string.
# Example: postgresql+psycopg2://kbs_user:change_me@localhost:5432/kbs_toolbox
DATABASE_URL=postgresql+psycopg2://kbs_user:change_me@localhost:5432/kbs_toolbox

# For local testing without Postgres installed, you can instead use SQLite:
# DATABASE_URL=sqlite:///./kbs_toolbox.db

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- App ---
APP_ENV=development
APP_NAME=KBS Toolbox API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Seed / demo ---
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@kbstoolbox.local
DEMO_ADMIN_PASSWORD=ChangeMe123!
