##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   IMPORTANT: This file's gradle-wrapper.jar counterpart is NOT included in
#   this project archive (it is a binary and could not be fetched without
#   network access in the environment this project was authored in). Run
#   `gradle wrapper --gradle-version 8.7` once with any local Gradle
#   installation to generate gradle/wrapper/gradle-wrapper.jar, or invoke
#   `gradle` directly instead of `./gradlew` (this is what CI does).
#
##############################################################################

APP_HOME=$(cd "$(dirname "$0")" >/dev/null && pwd)

APP_NAME="Gradle"
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

MAX_FD="maximum"

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

case "$(uname)" in
  CYGWIN* | MINGW* | MSYS* )
    NONSTOP=true
    ;;
esac

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$CLASSPATH" ]; then
    die "ERROR: gradle/wrapper/gradle-wrapper.jar is missing. See the note at the top of this script for how to generate it, or run 'gradle' directly instead of './gradlew'."
fi

if [ -n "$JAVA_HOME" ]; then
    if [ -x "$JAVA_HOME/jre/sh/java" ]; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ]; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and 'java' was not found in your PATH."
fi

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
